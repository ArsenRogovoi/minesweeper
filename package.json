{
  "name": "minesweeper",
  "version": "0.1.0",
  "private": true,
  "description": "Windows XP style Minesweeper in the browser",
  "type": "module",
  "scripts": {
    "dev": "run-p sass:watch serve",
    "serve": "browser-sync start --server --no-open --files \"index.html, css/*.css, src/**/*.js\"",
    "build:css": "sass --load-path=src/scss src/scss/main.scss css/main.css",
    "sass:watch": "npm run build:css -- --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.5",
    "browser-sync": "^3.0.4",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.10",
    "sass": "^1.105.2",
    "vitest": "^5.0.5"
  }
}
